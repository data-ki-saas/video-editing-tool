# Only used for local runs -- on Cloud Run, set these as the service's own
# env vars (console or `gcloud run services update --set-env-vars`), not via
# a committed/uploaded .env file.

# Shared secret backend/ sends as the `x-internal-secret` header (see
# backend/.env's FACE_ANALYSIS_SERVICE_SECRET -- must match exactly). Same
# convention as worker/'s WORKER_INTERNAL_SECRET: generate with
# `openssl rand -hex 32`.
FACE_ANALYSIS_SERVICE_SECRET=

# Attempt mediapipe's GPU delegate before falling back to CPU. Only set this
# true on a GPU-attached Cloud Run revision (see DEPLOY.md's Cloud Run
# section) -- leave false for a plain CPU deploy or a local run.
FACE_ANALYSIS_USE_GPU=false
