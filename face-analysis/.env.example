# Only used for local runs -- on Render, set these as the service's own
# env vars (dashboard, or render.yaml's envVars with sync: false), not via
# a committed/uploaded .env file.

# Shared secret backend/ sends as the `x-internal-secret` header (see
# backend/.env's FACE_ANALYSIS_SERVICE_SECRET -- must match exactly). Same
# convention as worker/'s WORKER_INTERNAL_SECRET: generate with
# `openssl rand -hex 32`.
FACE_ANALYSIS_SERVICE_SECRET=

# Attempt mediapipe's GPU delegate before falling back to CPU. There's no
# GPU-attached deploy target anymore (this service runs on Render, CPU-only)
# -- leave false.
FACE_ANALYSIS_USE_GPU=false
