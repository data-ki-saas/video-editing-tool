MAX_UPLOAD_SIZE_MB=500

CORS_ORIGINS=https://timeline-editor-backend.onrender.com

# Which LLMProvider src.llm.client.get_llm_provider() returns: deepseek | anthropic
LLM_PROVIDER=deepseek

# DeepSeek (https://platform.deepseek.com) — used to generate a niche's
# form fields + voiceover script template the first time it's requested
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Supabase (Database + Auth) — Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (S3-compatible storage) — R2 > Manage API Tokens
# The bucket must be PRIVATE (no public access, no r2.dev/custom domain) --
# reads only ever happen through a presigned URL generated by this backend.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_SIGNED_URL_EXPIRES_SECONDS=3600

# The finished-renders bucket (public, fed by worker/) uses its OWN API
# token, scoped to only that bucket -- same value given to worker/'s
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY (see DEPLOY.md step 2b). Only used
# here to delete a render object when its reel is deleted.
R2_RENDERS_ACCESS_KEY_ID=
R2_RENDERS_SECRET_ACCESS_KEY=
R2_RENDERS_BUCKET_NAME=

# Pexels (https://www.pexels.com/api/new) — stock photo/video search
PEXELS_API_KEY=

# Freesound (https://freesound.org/apiv2/apply/) — stock background-music
# search. Only CC0-licensed tracks are ever returned/imported (see
# stock_media/freesound_client.py), so this is free to use commercially
# with no attribution required.
FREESOUND_API_KEY=
