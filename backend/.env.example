MAX_UPLOAD_SIZE_MB=500

CORS_ORIGINS=http://localhost:3000

# Supabase (Database + Auth) — Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (S3-compatible storage) — R2 > Manage API Tokens
# The bucket must be PRIVATE (no public access, no r2.dev/custom domain) --
# reads only ever happen through a presigned URL generated by this backend.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_SIGNED_URL_EXPIRES_SECONDS=3600
