NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

NEXT_PUBLIC_CREATOMATE_PUBLIC_TOKEN=

# --- Secrets below: server-only, never prefix with NEXT_PUBLIC_ ---

# Used by app/api/render/route.ts to trigger renders. Creatomate dashboard > API keys.
CREATOMATE_API_KEY=
# This app's own public origin (e.g. https://your-app.vercel.app or a custom
# domain) -- used to build the webhook_url handed to Creatomate. Falls back
# to Vercel's own VERCEL_URL if unset, so this is only required for local
# testing against a tunnel, or to force a stable custom domain.
SITE_URL=
# A long random string you generate yourself (e.g. `openssl rand -hex 32`).
# Creatomate has no signed-webhook mechanism, so this, embedded in
# webhook_url's query string, IS the check that a callback is genuine --
# see app/api/webhooks/creatomate/route.ts.
CREATOMATE_WEBHOOK_SECRET=
# Bypasses RLS -- needed because the Creatomate webhook has no Supabase user
# session to authenticate with. Supabase dashboard > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=
# The R2-transfer worker's URL and its own shared secret (see worker/).
RENDER_WORKER_URL=
WORKER_INTERNAL_SECRET=
