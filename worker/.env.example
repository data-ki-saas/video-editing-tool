PORT=3001
# Shared secret the webhook route sends as `x-internal-secret` -- the only
# thing standing between this endpoint and anyone who finds its URL. Generate
# with e.g. `openssl rand -hex 32` and keep it identical to the frontend's
# WORKER_INTERNAL_SECRET.
WORKER_INTERNAL_SECRET=

# Cloudflare R2 -- use a token scoped ONLY to the renders bucket below, not
# the same one backend/ uses for the private raw-uploads bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_RENDERS_BUCKET_NAME=
# The Cloudflare custom domain connected to that bucket (R2 > bucket >
# Settings > Public access > Custom Domains), e.g. https://videos.example.com
R2_RENDERS_PUBLIC_URL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
